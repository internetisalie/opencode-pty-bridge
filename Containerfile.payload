# Payload image: the OpenCode v2 plugin payload at the image root, nothing else.
# The build context holds server.js and package.json; see README "Release image".
FROM scratch
ARG SOURCE
ARG REVISION
ARG VERSION
ARG TITLE
LABEL org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="${TITLE}"
COPY --chmod=0644 server.js package.json /
