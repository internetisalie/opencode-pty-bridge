{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-pty-bridge",
  "version": "0.1.0",
  "description": "Read-only HTTP bridge exposing opencode-pty sessions through OpenCode's authenticated plugin HTTP routes",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "opencode": ">=1.18.31"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "opencode-pty": "0.4.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@types/bun": "^1.3.8",
    "typescript": "^5.9.3"
  }
}
