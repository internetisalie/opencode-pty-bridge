{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@internetisalie/opencode-pty-bridge",
  "version": "0.1.0",
  "description": "Read-only HTTP bridge exposing opencode-pty sessions through OpenCode's authenticated plugin HTTP routes",
  "author": "internetisalie",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/internetisalie/opencode-pty-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/internetisalie/opencode-pty-bridge/issues"
  },
  "homepage": "https://github.com/internetisalie/opencode-pty-bridge#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "opencode": ">=1.18.31"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@internetisalie/opencode-pty": "0.4.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@types/bun": "^1.3.8",
    "typescript": "^5.9.3"
  }
}
